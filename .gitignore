# Dependencies and build output — never commit these
node_modules/
.next/
out/
build/
.vercel/

# Secrets — the Web3Forms key lives here. Must never reach GitHub.
.env
.env.local
.env*.local

# Loose notes that have held the access key in plain text. A .txt is not
# covered by the .env rules above, so it would otherwise be committed to a
# public repo on the next `git add -A`.
env.txt
**/env.txt
*key*.txt

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Python bytecode from local generator scripts
__pycache__/
*.pyc
