# ---------------------------------------------------------------------------
# Contact form delivery (Web3Forms)
# ---------------------------------------------------------------------------
# 1. Go to https://web3forms.com
# 2. Enter  hundalg968@gmail.com  in the "Create Access Key" box
# 3. They email that address an access key (a UUID). Check spam if it's slow.
# 4. Copy this file to  .env.local  and paste the key below
# 5. Restart the dev server (Ctrl+C, then start-dev.bat again)
#
# Every form submission then arrives at the inbox you registered. The key can
# only deliver to that address, so it's safe in client-side code.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_WEB3FORMS_KEY=paste-your-access-key-here
